# Copia este archivo como `.env` (nunca subas el `.env` real a git — ya
# está en .gitignore junto a db.sqlite3) y rellena los valores reales.
#
# En LOCAL no hace falta nada más: `todoapp/settings.py` carga este
# `.env` solo con tenerlo en la raíz del proyecto (requiere
# python-dotenv, ya en requirements.txt) — nada de `setx` ni `$env:` ni
# reiniciar la terminal cada vez que cambias una clave. Si ya tenías una
# variable de entorno puesta a mano (con `setx`, por ejemplo), esa
# manda siempre sobre lo que haya en el `.env`, nunca al revés.
#
# En PythonAnywhere, la forma recomendada de cargar esto es con
# python-dotenv desde tu archivo WSGI — ver instrucciones abajo.

# Clave secreta de Django — OBLIGATORIA en producción, nunca la que
# trae el repo por defecto (esa es solo para desarrollo local). Pero en
# LOCAL déjala comentada (mismo motivo que DJANGO_DEBUG más abajo): si
# el .env la define aunque sea en blanco, ya no usa la clave insegura
# de settings.py y Django falla con "The SECRET_KEY setting must not
# be empty." Descomenta y rellena solo para producción.
# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# "False" en producción, SIEMPRE — pero en LOCAL déjala comentada (no
# la actives ni la pongas en blanco): `settings.py` solo cae en su
# default de "True" cuando la variable NO EXISTE; si el .env la define
# aunque sea en blanco, ya cuenta como definida y DEBUG sale False, y
# entonces `runserver` falla con "You must set settings.ALLOWED_HOSTS
# if DEBUG is False". Descomenta esta línea (con "False") solo cuando
# subas este .env de verdad a producción.
# DJANGO_DEBUG=False

# Dominios permitidos, separados por coma. Ej: tuusuario.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=

# Orígenes CORS extra (para la app móvil), separados por coma. Vacío
# si la app móvil no llama a esta API todavía.
EXTRA_CORS_ORIGINS=

# Candado HTTP Basic para toda la app. Si dejas los dos en blanco, el
# candado queda DESACTIVADO — cualquiera con la URL entra sin login.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Gemini — lo ÚNICO que lo usa hoy es el test de repaso de Estudio ·
# Idiomas (preguntas cortas sobre los últimos vídeos vistos). Los planes
# de Deporte se generan automáticamente con matemáticas deterministas,
# sin IA de por medio (ver "Generar automáticamente" en Deporte). Sin
# esto, el test de repaso falla con un aviso legible en vez de reventar
# — el resto de la app sigue igual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# YouTube Data API v3 (búsqueda y verificación de playlists del
# catálogo de idiomas). Sin esto, add_course_playlist/search_courses
# fallan con un aviso legible — el resto de la app sigue igual.
YOUTUBE_API_KEY=

# --------------------------------------------------------------------
# Cómo cargar esto en PythonAnywhere (no hay panel de variables de
# entorno para apps web — se hace desde el archivo WSGI):
#
# 1. Sube este .env (con tus valores reales) a la carpeta del proyecto
#    en PythonAnywhere, NUNCA a git.
# 2. En una consola bash de PythonAnywhere, con tu virtualenv activado:
#      pip install python-dotenv
# 3. En el "Web" tab, abre el enlace a tu archivo WSGI y añade, ANTES
#    de las líneas que importan la app de Django:
#      import os
#      from dotenv import load_dotenv
#      load_dotenv(os.path.join(os.path.dirname(__file__), '.env'))
#    (el path exacto depende de dónde subiste el .env — ajústalo)
# 4. Guarda y dale a "Reload" en el Web tab.
