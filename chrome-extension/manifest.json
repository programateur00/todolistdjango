{
  "manifest_version": 3,
  "name": "Libreta — Tiempo en Udemy",
  "version": "1.1.5",
  "description": "Cuenta el tiempo real que pasas viendo tus cursos de Udemy o leyendo un PDF con la pestana en primer plano, y lo manda a tu Libreta de tareas.",
  "permissions": [
    "tabs",
    "idle",
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.udemy.com/*",
    "file:///*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Libreta — Tiempo en Udemy",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
